{
  "schema_version": 1,
  "skill": "cloud-architecture-diagrammer",
  "model": "EstimateModel",
  "effort_unit": "JH",
  "inputs": ["metadata", "assumptions", "inventory", "architecture", "tasks", "cloud_costs", "scenarios", "phasing", "risks", "decisions", "sources"],
  "outputs": {
    "inventory": {
      "section": "inventory",
      "required_keys": ["id", "component", "environment", "quantity", "unit", "notes"],
      "workbook_sheet": "02_Inventaire"
    },
    "topology-node": {
      "section": "architecture",
      "required_keys": ["id", "component", "type", "environment", "provider", "decision", "notes"],
      "workbook_sheet": "03_Architecture"
    },
    "flow-evidence": {
      "section": "sources",
      "required_keys": ["id", "title", "type", "date", "url", "notes"],
      "workbook_sheet": "10_Sources"
    },
    "topology-issue": {
      "section": "risks",
      "required_keys": ["id", "risk", "impact", "probability", "mitigation", "owner", "status"],
      "workbook_sheet": "08_Risques"
    },
    "diagram-task": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Build"}
    }
  },
  "diagram_fields": {
    "required": ["inventory_node_ids", "nodes", "edges", "icon_provenance", "artifacts", "topology_verification"],
    "nodes": {
      "required_keys": ["id", "component", "environment", "zone", "provider", "icon"],
      "id_reference": "inventory.id",
      "coverage": "exact"
    },
    "edges": {
      "required_keys": ["id", "source", "target", "label"],
      "endpoint_reference": "nodes.id",
      "evidence_reference": "sources.id",
      "infer_connections": false
    },
    "topology_verification": {
      "before": "estimate-finalisation",
      "reject": ["duplicate-node-id", "duplicate-edge-id", "node-absent-from-inventory", "missing-inventory-node", "dangling-flow"],
      "unresolved_flow": "risk-or-assumption"
    },
    "icon_provenance": {
      "default": "provider-neutral",
      "asset_formats": ["PNG"],
      "required_keys": ["path", "sha256", "provider", "official_source_url", "licence_or_trademark_notice"]
    },
    "artifacts": {
      "exports": ["SVG", "PNG"],
      "primary": "XLSX",
      "embed": {"sheet": "03_Architecture", "format": "PNG"},
      "manifest_keys": ["node_ids", "edge_ids", "icon_sources", "icon_provenance", "output_hashes", "warnings"]
    }
  }
}
