{
  "schema_version": 1,
  "skill": "hosting-capacity-simulator",
  "model": "EstimateModel",
  "effort_unit": "JH",
  "inputs": [
    "metadata",
    "assumptions",
    "inventory",
    "architecture",
    "tasks",
    "cloud_costs",
    "scenarios",
    "phasing",
    "risks",
    "decisions",
    "sources"
  ],
  "outputs": {
    "sizing-input": {
      "section": "assumptions",
      "required_keys": [
        "key",
        "value",
        "unit",
        "status",
        "source",
        "notes"
      ],
      "workbook_sheet": "01_Hypotheses"
    },
    "capacity-result": {
      "section": "assumptions",
      "required_keys": [
        "key",
        "value",
        "unit",
        "status",
        "source",
        "notes"
      ],
      "workbook_sheet": "01_Hypotheses"
    },
    "measurement-task": {
      "section": "tasks",
      "required_keys": [
        "id",
        "lot",
        "domain",
        "task",
        "deliverable",
        "environment",
        "role",
        "prerequisites",
        "dependencies",
        "acceptance_criterion",
        "expected_evidence",
        "jh_low",
        "jh_likely",
        "jh_high",
        "scenario_override",
        "nature",
        "coverage",
        "source",
        "confidence",
        "notes"
      ],
      "workbook_sheet": "04_Taches_JH"
    },
    "scenario": {
      "section": "scenarios",
      "required_keys": [
        "name",
        "description",
        "notes"
      ],
      "workbook_sheet": "06_Scenarios"
    },
    "risk": {
      "section": "risks",
      "required_keys": [
        "id",
        "risk",
        "impact",
        "probability",
        "mitigation",
        "owner",
        "status"
      ],
      "workbook_sheet": "08_Risques"
    },
    "capacity-unit": {
      "section": "inventory",
      "required_keys": [
        "id",
        "component",
        "environment",
        "quantity",
        "unit",
        "notes"
      ],
      "workbook_sheet": "02_Inventaire"
    },
    "topology": {
      "section": "architecture",
      "required_keys": [
        "id",
        "component",
        "type",
        "environment",
        "provider",
        "decision",
        "notes"
      ],
      "workbook_sheet": "03_Architecture"
    },
    "decision": {
      "section": "decisions",
      "required_keys": [
        "id",
        "question",
        "option",
        "rationale",
        "status",
        "source"
      ],
      "workbook_sheet": "09_Arbitrages"
    },
    "source": {
      "section": "sources",
      "required_keys": [
        "id",
        "title",
        "type",
        "date",
        "url",
        "notes"
      ],
      "workbook_sheet": "10_Sources"
    },
    "phase": {
      "section": "phasing",
      "required_keys": [
        "phase",
        "sequence",
        "milestone",
        "notes"
      ],
      "workbook_sheet": "07_Phasage"
    }
  },
  "capacity_inputs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cpu",
      "memory",
      "storage",
      "iops",
      "bandwidth",
      "concurrency",
      "utilisation_target",
      "scaling_limit",
      "failure_domain_reserve"
    ],
    "properties": {
      "cpu": {
        "type": "number",
        "minimum": 0,
        "unit": "vCPU"
      },
      "memory": {
        "type": "number",
        "minimum": 0,
        "unit": "GiB"
      },
      "storage": {
        "type": "number",
        "minimum": 0,
        "unit": "GiB"
      },
      "iops": {
        "type": "number",
        "minimum": 0,
        "unit": "operations/s"
      },
      "bandwidth": {
        "type": "number",
        "minimum": 0,
        "unit": "Mbit/s"
      },
      "concurrency": {
        "type": "integer",
        "minimum": 0,
        "unit": "requests"
      },
      "utilisation_target": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1,
        "unit": "ratio"
      },
      "scaling_limit": {
        "type": "integer",
        "minimum": 1,
        "unit": "instances"
      },
      "failure_domain_reserve": {
        "type": "integer",
        "minimum": 0,
        "unit": "instances"
      }
    },
    "x-cross-field-constraints": [
      "failure_domain_reserve < scaling_limit"
    ],
    "x-provenance": "Each payload is scoped to a workload, environment, service scenario and workload band; source, measurement window and measurement-or-assumption status are EstimateModel assumption fields.",
    "x-reserve-semantics": "Number of capacity units simultaneously unavailable in the tested failure domain; zone failures require the largest-zone placement calculation, not a fixed N+1."
  }
}
