{
  "schema_version": 1,
  "skill": "cloud-migration-estimator",
  "model": "EstimateModel",
  "effort_unit": "JH",
  "inputs": ["metadata", "assumptions", "inventory", "architecture", "tasks", "cloud_costs", "scenarios", "phasing", "risks", "decisions", "sources"],
  "outputs": {
    "inventory": {
      "section": "inventory",
      "required_keys": ["id", "component", "environment", "quantity", "unit", "notes"],
      "workbook_sheet": "02_Inventaire"
    },
    "source-write-policy": {
      "section": "assumptions",
      "required_keys": ["key", "value", "unit", "status", "source", "notes"],
      "workbook_sheet": "01_Hypotheses"
    },
    "documentation-drift": {
      "section": "decisions",
      "required_keys": ["id", "question", "option", "rationale", "status", "source"],
      "workbook_sheet": "09_Arbitrages"
    },
    "service-mapping": {
      "section": "architecture",
      "required_keys": ["id", "component", "type", "environment", "provider", "decision", "notes"],
      "workbook_sheet": "03_Architecture"
    },
    "migration-task": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Build"}
    },
    "recurring-operation": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Run", "period": "month"}
    },
    "risk": {
      "section": "risks",
      "required_keys": ["id", "risk", "impact", "probability", "mitigation", "owner", "status"],
      "workbook_sheet": "08_Risques"
    },
    "source": {
      "section": "sources",
      "required_keys": ["id", "title", "type", "date", "url", "notes"],
      "workbook_sheet": "10_Sources"
    }
  },
  "migration_fields": {
    "required": ["inventory_evidence", "documentation_drift", "source_write_policy", "source_target_mapping", "preparation", "rehearsal", "data_transfer", "cutover", "integrity", "rollback", "decommissioning", "hypercare", "one_off_jh", "recurring_jh"],
    "bindings": {
      "inventory_evidence": {"record": "inventory", "keys": ["id", "notes"]},
      "documentation_drift": {"record": "documentation-drift", "keys": ["question", "option", "rationale", "status", "source"]},
      "source_write_policy": {"record": "source-write-policy", "keys": ["value", "status", "source", "notes"]},
      "source_target_mapping": {"record": "service-mapping", "keys": ["id", "component", "decision", "notes"]},
      "preparation": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "rehearsal": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "data_transfer": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "cutover": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "integrity": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "rollback": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "decommissioning": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "hypercare": {"record": "migration-task", "keys": ["task", "dependencies", "acceptance_criterion", "expected_evidence", "notes"]},
      "one_off_jh": {"record": "migration-task", "keys": ["jh_low", "jh_likely", "jh_high"]},
      "recurring_jh": {"record": "recurring-operation", "keys": ["jh_low", "jh_likely", "jh_high"]}
    },
    "constraints": {
      "source_write_policy": ["forbidden", "owner-only", "scoped-authorised", "unknown"],
      "inventory_method": "read-only-live-first"
    }
  }
}
