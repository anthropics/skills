    },
    "source": {
      "section": "sources", "required_keys": ["id", "title", "type", "date", "url", "notes"], "workbook_sheet": "10_Sources"
    },
    "scenario": {
      "section": "scenarios", "required_keys": ["name", "description", "notes"], "workbook_sheet": "06_Scenarios"
    },
    "phase": {
      "section": "phasing", "required_keys": ["phase", "sequence", "milestone", "notes"], "workbook_sheet": "07_Phasage"
    }
  }
}
