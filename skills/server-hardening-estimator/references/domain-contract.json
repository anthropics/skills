    "assumption": {
      "section": "assumptions", "required_keys": ["key", "value", "unit", "status", "source", "notes"], "workbook_sheet": "01_Hypotheses"
    },
    "residual-risk": {
      "section": "risks", "required_keys": ["id", "risk", "impact", "probability", "mitigation", "owner", "status"], "workbook_sheet": "08_Risques"
