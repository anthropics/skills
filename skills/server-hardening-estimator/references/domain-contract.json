    "verification_evidence": {"record": "control-task", "keys": ["expected_evidence"]},
    "one_off_jh": {"record": "control-task", "keys": ["jh_low", "jh_likely", "jh_high"]},
    "recurring_jh": {"record": "recurring-operation", "keys": ["jh_low", "jh_likely", "jh_high"]},
    "residual_risk": {"record": "residual-risk", "keys": ["risk", "mitigation", "owner", "status"]}
  },
  "outputs": {
    "control-task": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Build"}
    },
    "recurring-operation": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Run", "period": "month"}
    },
    "inventory": {
      "section": "inventory", "required_keys": ["id", "component", "environment", "quantity", "unit", "notes"], "workbook_sheet": "02_Inventaire"
    },
    "architecture": {
      "section": "architecture", "required_keys": ["id", "component", "type", "environment", "provider", "decision", "notes"], "workbook_sheet": "03_Architecture"
