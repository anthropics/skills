{
  "schema_version": 1,
  "skill": "finops-optimizer",
  "model": "EstimateModel",
  "effort_unit": "JH",
  "inputs": ["metadata", "assumptions", "inventory", "architecture", "tasks", "cloud_costs", "scenarios", "phasing", "risks", "decisions", "sources"],
  "outputs": {
    "opportunity": {
      "section": "decisions",
      "required_keys": ["id", "question", "option", "rationale", "status", "source"],
      "workbook_sheet": "09_Arbitrages"
    },
    "baseline": {
      "section": "assumptions",
      "required_keys": ["key", "value", "unit", "status", "source", "notes"],
      "workbook_sheet": "01_Hypotheses"
    },
    "implementation-task": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Build"}
    },
    "recurring-operation": {
      "section": "tasks",
      "required_keys": ["id", "lot", "domain", "task", "deliverable", "environment", "role", "prerequisites", "dependencies", "acceptance_criterion", "expected_evidence", "jh_low", "jh_likely", "jh_high", "scenario_override", "nature", "coverage", "source", "confidence", "notes"],
      "workbook_sheet": "04_Taches_JH",
      "constraints": {"nature": "Run", "period": "month"}
    },
    "cloud-cost": {
      "section": "cloud_costs",
      "required_keys": ["id", "provider", "service", "environment", "scenario", "unit", "quantity", "unit_price", "currency", "monthly_multiplier", "source", "confidence", "notes"],
      "workbook_sheet": "05_Couts_cloud"
    },
    "risk": {
      "section": "risks",
      "required_keys": ["id", "risk", "impact", "probability", "mitigation", "owner", "status"],
      "workbook_sheet": "08_Risques"
    },
    "source": {
      "section": "sources",
      "required_keys": ["id", "title", "type", "date", "url", "notes"],
      "workbook_sheet": "10_Sources"
    }
  },
  "opportunity_fields": {
    "required": ["baseline", "action", "savings_range", "one_off_jh", "recurring_jh", "risk", "reversibility", "validation_method"],
    "bindings": {
      "baseline": {"record": "baseline", "keys": ["value", "unit", "status", "source", "notes"]},
      "action": {"record": "opportunity", "keys": ["option"]},
      "savings_range": {"record": "opportunity", "keys": ["rationale"]},
      "one_off_jh": {"record": "implementation-task", "keys": ["jh_low", "jh_likely", "jh_high"]},
      "recurring_jh": {"record": "recurring-operation", "keys": ["jh_low", "jh_likely", "jh_high"]},
      "risk": {"record": "risk", "keys": ["risk", "mitigation", "owner", "status"]},
      "reversibility": {"record": "opportunity", "keys": ["rationale"]},
      "validation_method": {"record": "implementation-task", "keys": ["acceptance_criterion", "expected_evidence"]}
    },
    "constraints": {
      "baseline_kind": ["measured-billing", "forecast"],
      "savings_status": ["forecast", "validated-measured"]
    }
  }
}
